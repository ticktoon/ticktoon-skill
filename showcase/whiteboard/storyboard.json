{
  "recipe": "whiteboard-explainer",
  "format": {
    "w": 1920,
    "h": 1080,
    "fps": 30
  },
  "meta": {
    "title": "水循环 · 一滴水的环球旅行"
  },
  "scenes": [
    {
      "id": "s01",
      "narration": "每一滴海水，都在进行一场环球旅行。太阳把海面晒热，水悄悄变成看不见的水蒸气，向上飘走。",
      "transition": "dip-fade",
      "resources": [
        { "type": "font", "name": "TsangerYuMo" }
      ],
      "code": [
        "const T = api.t;",
        "const clamp01 = TT.clamp01;",
        "const ease = TT.ease;",
        "const TAU = Math.PI * 2;",
        "const SCALE = RULES.scale || { title: 1, label: 0.8, note: 0.6 };",
        "const STROKE = Array.isArray(RULES.stroke) ? RULES.stroke : [2.4, 4.5];",
        "const M = Number.isFinite(RULES.safeMargin) ? RULES.safeMargin : 0.06;",
        "const thin = STROKE[0];",
        "const mid = (STROKE[0] + STROKE[1]) / 2;",
        "const bold = STROKE[1];",
        "const titlePx = 66 * SCALE.title;",
        "const labelPx = 52 * SCALE.label;",
        "const notePx = 50 * SCALE.note;",
        "const ink = '#343a3b';",
        "const blue = '#446b84';",
        "const red = '#c0503f';",
        "const alpha = TT.env.fade(T, api.d, 0.62, 0.3472);",
        "ctx.save();",
        "ctx.globalAlpha = alpha;",
        "TT.board.paper(ctx, api);",
        "const FRAME = { x: -70, y: 30, w: 2060, h: 850 };",
        "const frames = TT.geom.keyframes({ mode: 'in', from: 1.0, to: 1.0, focus: [0.5, 0.5] }, api.d);",
        "const safe = TT.geom.safeBox({ W, H, m: M });",
        "const pre = TT.geom.preimage({ frames, dur: api.d, W, H, safe });",
        "const framing = TT.geom.fit(FRAME, pre);",
        "const fit = framing.scale;",
        "const z = TT.geom.camera(frames, T);",
        "const scale = Math.min(2, Math.max(0.01, z.scale));",
        "const fx = clamp01(z.fx) * W;",
        "const fy = clamp01(z.fy) * H;",
        "ctx.save();",
        "ctx.translate(fx, fy);",
        "ctx.scale(scale, scale);",
        "ctx.translate(-fx, -fy);",
        "ctx.translate(framing.dx, framing.dy);",
        "ctx.scale(framing.scale, framing.scale);",
        "const prog = (value, at, dur = 1) => ease.inOutCubic(clamp01((value - at) / dur));",
        "const cubic = (a, b, c, d, n = 28) => {",
        "  const pts = [];",
        "  for (let i = 0; i <= n; i += 1) {",
        "    const k = i / n;",
        "    const u = 1 - k;",
        "    pts.push([",
        "      u * u * u * a[0] + 3 * u * u * k * b[0] + 3 * u * k * k * c[0] + k * k * k * d[0],",
        "      u * u * u * a[1] + 3 * u * u * k * b[1] + 3 * u * k * k * c[1] + k * k * k * d[1],",
        "    ]);",
        "  }",
        "  return pts;",
        "};",
        "const line = (x1, y1, x2, y2, n = 20) => {",
        "  const pts = [];",
        "  for (let i = 0; i <= n; i += 1) {",
        "    pts.push([x1 + (x2 - x1) * (i / n), y1 + (y2 - y1) * (i / n)]);",
        "  }",
        "  return pts;",
        "};",
        "const strokes = [];",
        "const heroStrokes = [];",
        "const stroke = (pts, at, dur, color = ink, width = mid, dash = [], hero = false) => {",
        "  const item = { pts, at, dur, pen: 'marker', color, width, dash, seed: 0 };",
        "  (hero ? heroStrokes : strokes).push(item);",
        "};",
        "const label = (value, x, y, size, color, k, align = 'left', rotate = -0.012) => {",
        "  if (k <= 0) return;",
        "  ctx.save();",
        "  ctx.translate(x, y + (1 - k) * 12);",
        "  ctx.rotate(rotate);",
        "  ctx.globalAlpha = clamp01(k) * alpha;",
        "  TT.text(ctx, value, 0, 0, size, { color, align, fontKey: 'TsangerYuMo' });",
        "  ctx.restore();",
        "};",
        "label('水循环', 960, 130, titlePx, ink, prog(T, 0.25, 0.45), 'center', -0.018);",
        "TT.mark.underline(ctx, { from: [810, 162], to: [1110, 162], color: red, width: bold, progress: prog(T, 0.85, 0.4), penBody: true, sceneScale: fit * scale });",
        "const wave = [];",
        "for (let i = 0; i <= 26; i += 1) {",
        "  wave.push([260 + i * (1400 / 26), 600 + Math.sin(i * 0.7) * 9]);",
        "}",
        "stroke(wave, 1.7, 1.3, blue, bold, [], true);",
        "for (let i = 0; i < 5; i += 1) {",
        "  stroke([[320 + i * 24, 640 + i * 34], [700, 636 + i * 34], [1080, 642 + i * 34], [1520 - i * 30, 638 + i * 34]], 3.1 + i * 0.03, 0.12, '#7ba0aa', thin, [16, 14]);",
        "}",
        "label('海 洋', 960, 745, labelPx, blue, prog(T, 3.45, 0.5), 'center', -0.015);",
        "TT.mark.circle(ctx, { at: [430, 270], rx: 62, ry: 62, color: '#d9a13b', width: bold, progress: prog(T, 4.15, 0.55), penBody: true, sceneScale: fit * scale });",
        "for (let i = 0; i < 12; i += 1) {",
        "  const a = (TAU * i) / 12;",
        "  stroke([[430 + Math.cos(a) * 84, 270 + Math.sin(a) * 84], [430 + Math.cos(a) * 114, 270 + Math.sin(a) * 114]], 4.75 + i * 0.02, 0.1, '#d9a13b', mid);",
        "}",
        "label('太阳', 430, 405, notePx, '#8a6d2f', prog(T, 5.05, 0.4), 'center');",
        "TT.mark.arrow(ctx, { via: [[770, 560], [812, 505], [735, 455], [795, 395]], color: '#5c8094', width: mid, progress: prog(T, 5.8, 0.9), penBody: true, sceneScale: fit * scale, smooth: true });",
        "TT.mark.arrow(ctx, { via: [[1010, 555], [1052, 500], [975, 450], [1035, 390]], color: '#5c8094', width: mid, progress: prog(T, 6.55, 0.8), sceneScale: fit * scale, smooth: true });",
        "TT.mark.arrow(ctx, { via: [[1250, 555], [1292, 500], [1215, 450], [1275, 390]], color: '#5c8094', width: mid, progress: prog(T, 7.25, 0.8), sceneScale: fit * scale, smooth: true });",
        "label('水蒸气', 1395, 355, notePx, '#5c8094', prog(T, 7.9, 0.4), 'left');",
        "TT.pen.track(ctx, strokes, T, { sceneScale: fit * scale, penBody: false });",
        "TT.pen.track(ctx, heroStrokes, T, { sceneScale: fit * scale });",
        "ctx.restore();",
        "ctx.restore();"
      ]
    },
