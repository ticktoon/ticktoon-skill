        "  }",
        "  const k2 = prog(T, NP0 + 1.15, 0.5);",
        "  if (k2 > 0) {",
        "    ctx.save();",
        "    ctx.globalAlpha = k2 * alpha;",
        "    TT.text(ctx, '一滴不少', 0, 62, 48, { color: '#292824', align: 'center', fontKey: 'TsangerYuMo' });",
        "    ctx.restore();",
        "  }",
        "  ctx.restore();",
        "}",
        "TT.pen.track(ctx, strokes, T, { sceneScale: fit * scale, penBody: false });",
        "TT.pen.track(ctx, heroStrokes, T, { sceneScale: fit * scale });",
        "ctx.restore();",
        "ctx.restore();"
      ]
    }
  ]
}
