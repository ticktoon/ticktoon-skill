{
  "id": "scene.shadow",
  "group": "scene",
  "inkless": true,
  "when": "整幅透光幕布：关节剪影由 characters[] 给出，保留操纵杆、镂空纸片与灯影随动。",
  "energy": {
    "level": "mid",
    "why": "一步一晃的步进节拍与姿态切换提供舞台节奏"
  },
  "slots": [
    "full"
  ],
  "defaultSlot": "full",
  "params": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 12
    },
    "subtitle": {
      "type": "string",
      "maxChars": 24,
      "default": ""
    },
    "plaques": {
      "type": "array",
      "maxItems": 2,
      "maxChars": 12,
      "default": []
    },
    "characters": {
      "type": "objects",
      "maxItems": 4,
      "fields": {
        "kind": {
          "enum": [
            "adult",
            "child",
            "animal",
            "object"
          ],
          "default": "adult"
        },
        "pose": {
          "enum": [
            "stand",
            "walk",
            "wave",
            "raise",
            "sit"
          ],
          "default": "stand"
        },
        "x": {
          "type": "number",
          "default": 0.78
        },
        "scale": {
          "type": "number",
          "default": 1
        },
        "color": {
          "type": "string",
          "default": "#a8432e"
        },
        "prop": {
          "enum": [
            "none",
            "staff",
            "fan",
            "lantern",
            "blade"
          ],
          "default": "none"
        }
      },
      "default": [
        {
          "kind": "adult",
          "pose": "stand",
          "x": 0.78,
          "scale": 1,
          "color": "#a8432e",
          "prop": "none"
        }
      ]
    }
  },
  "defaultDuration": 17,
  "defaultSfx": "impact-soft",
  "needs": {
    "font": [
      "display",
      "body"
    ],
    "three": false,
    "video": false,
    "cache": false
  },
  "pitfalls": [
    "必须显式使用 rect=[0,0,1,1]，戏台需要出血到画面边缘",
    "幕布只由 TT.board.stage 画，block 不铺第二层底色",
    "characters[] 只描述骨架、姿态、位置、配色与道具，不写具体故事或人物姓名",
    "操纵杆与关节属于同一个场景，不要拆成素材卡片"
  ],
  "layout": {
    "full": [
      0,
      0,
      1,
      1
    ]
  },
  "motion": {
    "enter": 0.58,
    "exitRatio": 0.5,
    "stagger": 0,
    "rise": 0,
    "hold": {
      "min": 1.1,
      "perChar": 0.032
    }
  },
  "sizes": {
    "default": 60
  }
}
