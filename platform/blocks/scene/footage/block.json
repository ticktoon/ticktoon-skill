{
  "id": "scene.footage",
  "group": "scene",
  "inkless": true,
  "when": "整幅实拍配压屏短句：底部暗渐层保证可读性，适合 Pexels 等真实视频拼接。",
  "energy": {
    "level": "high",
    "why": "全幅实拍是视觉主体，文字与图形只提供导航"
  },
  "slots": [
    "full"
  ],
  "defaultSlot": "full",
  "params": {
    "src": {
      "type": "string",
      "required": true
    },
    "start": {
      "type": "number",
      "feel": "源视频起始秒"
    },
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 28,
      "feel": "1–2 行短句，用 \\n 显式换行"
    },
    "kicker": {
      "type": "string",
      "required": true,
      "maxChars": 24
    },
    "keywords": {
      "type": "array",
      "maxItems": 4,
      "maxChars": 12,
      "default": []
    },
    "credit": {
      "type": "string",
      "default": "Pexels",
      "maxChars": 40,
      "feel": "写 auto 时 assets fetch 回填作者；降级时明确标注内置素材"
    }
  },
  "defaultDuration": 5.5,
  "defaultSfx": null,
  "needs": {
    "font": [
      "display",
      "body"
    ],
    "three": false,
    "video": true,
    "cache": false
  },
  "pitfalls": [
    "必须显式使用 rect=[0,0,1,1]，视频 cover 裁切铺满，不加卡片边框",
    "只保留底部渐层与短句，不再叠加其他 title/caption block",
    "素材来源和作者以 out/media/pexels-manifest.json 为准，credit=auto 可由 CLI 回填"
  ],
  "layout": {
    "full": [
      0,
      0,
      1,
      1
    ]
  },
  "motion": {
    "enter": 0.56,
    "exitRatio": 0.55,
    "stagger": 0,
    "rise": 0,
    "hold": {
      "min": 1.1,
      "perChar": 0.032
    }
  },
  "sizes": {
    "default": 60
  }
}
