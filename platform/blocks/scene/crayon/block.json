{
  "id": "scene.crayon",
  "group": "scene",
  "inkless": true,
  "when": "整幅蜡笔绘本场景：暖米纸、斜纹蜡笔填充、手写标签与引线、紫描边气泡、蜡笔柱状图/步骤卡和红圈角标；适合菜谱图解与儿童科普。",
  "energy": {
    "level": "mid",
    "why": "食材与步骤被一笔一笔画出来，节奏像翻手账"
  },
  "slots": [
    "full"
  ],
  "defaultSlot": "full",
  "params": {
    "title": {
      "type": "string",
      "required": true,
      "maxChars": 10
    },
    "subtitle": {
      "type": "string",
      "maxChars": 14,
      "default": ""
    },
    "bubble": {
      "type": "string",
      "maxChars": 14,
      "default": ""
    },
    "badge": {
      "type": "string",
      "maxChars": 6,
      "default": "3步搞定"
    },
    "ingredients": {
      "type": "array",
      "maxItems": 4,
      "maxChars": 6,
      "default": [],
      "feel": "旧版纯文本清单；新配方优先用 items[] 图标槽"
    },
    "steps": {
      "type": "array",
      "maxItems": 3,
      "maxChars": 10,
      "default": []
    },
    "times": {
      "type": "array",
      "maxItems": 3,
      "maxChars": 8,
      "default": []
    },
    "note": {
      "type": "string",
      "maxChars": 24,
      "default": ""
    },
    "items": {
      "type": "objects",
      "maxItems": 4,
      "fields": {
        "kind": {
          "enum": [
            "bowl",
            "plate",
            "pot",
            "egg",
            "veg",
            "meat",
            "spice",
            "spoon"
          ],
          "default": "bowl"
        },
        "label": {
          "type": "string",
          "default": "",
          "maxChars": 8
        }
      },
      "default": []
    }
  },
  "defaultDuration": 16,
  "defaultSfx": null,
  "needs": {
    "font": [
      "display",
      "hand",
      "num"
    ],
    "three": false,
    "video": false,
    "cache": false
  },
  "pitfalls": [
    "整幅场景必须显式 rect=[0,0,1,1]，蜡笔纸底要铺满画幅",
    "蜡笔斜纹与颗粒只由序号哈希算出，禁止 Math.random；同一帧重复渲染必须给出同一张纸",
    "字幕统一交给 captions.handnote / captions.collage，场景块不画逐字标题",
    "steps 与 times 按同一顺序一一对应；最多 3 步，超出就换 recipe",
    "items[].kind 只取 8 种通用器皿/食材大类，label 写数量或名称，不许出现具体菜名"
  ],
  "layout": {
    "full": [
      0,
      0,
      1,
      1
    ]
  },
  "motion": {
    "enter": 0.66,
    "exitRatio": 0.52,
    "stagger": 0,
    "rise": 0,
    "hold": {
      "min": 1.1,
      "perChar": 0.032
    }
  },
  "sizes": {
    "default": 60
  }
}
