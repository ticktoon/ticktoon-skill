{
  "id": "whiteboard-explainer",
  "abi": "1",
  "name": "白板手写",
  "keywords": [
    "白板",
    "手写",
    "手绘",
    "板书",
    "画出来",
    "讲解"
  ],
  "mode": "code",
  "when": [
    "需要一步步把原理、结构或过程画给观众看，单场 10–20 秒。",
    "画面本身就是解释：剖面、流程、因果链要随旁白逐笔长出来。",
    "需要白纸马克笔或绿板粉笔的「正在被画出来」质感。"
  ],
  "notWhen": [
    "需要固定版式、换稿不换视觉的信息卡；改用 news-broadcast。",
    "需要插画故事或实拍；改用 crayon-guide / footage。",
    "需要快节奏大字连打；改用 flash-cut。"
  ],
  "rules": {
    "safeMargin": 0.06,
    "scale": {
      "title": 1,
      "label": 0.8,
      "note": 0.6
    },
    "stroke": [
      2.4,
      4.5
    ],
    "pen": {
      "mode": "enum",
      "choices": [
        "marker",
        "pencil"
      ],
      "default": "marker"
    },
    "board": {
      "mode": "enum",
      "choices": [
        "paper",
        "blackboard"
      ],
      "default": "paper"
    },
    "forbid": [
      "除一张便利贴外，整幅场景与其他卡片版式混排",
      "同场最多一张便利贴；用于盲区、反例、小结或补充，不代替主体",
      "同一幕出现两种字幕样式",
      "墨迹越出 safeMargin",
      "把讲解内容塞进 recipe 参数（叙事写在 storyboard 的 code 里）",
      "在同一场景写 scene.params；本 recipe 只收 scene.code"
    ]
  },
  "captions": {
    "style": "tornpaper",
    "font": "JiangChengYuanTi",
    "accent": "#82CDB6",
    "highlight": "#1F6F54",
    "baseSize": 44,
    "lineHeight": 1.34,
    "top": 0.8,
    "at": "bottom",
    "band": true
  },
  "audio": {
    "mood": "soft",
    "volume": 0.1,
    "fadeIn": 1.6,
    "fadeOut": 2.4,
    "duck": {
      "level": 0.04,
      "edge": 0.22
    }
  }
}
