{
  "id": "shadow-play",
  "abi": "9",
  "name": "皮影戏",
  "keywords": [
    "皮影",
    "灯影",
    "剪影",
    "戏台",
    "幕布",
    "透光"
  ],
  "when": "需要用透光幕布上的关节剪影演一段动作、靠姿态与操纵杆讲戏时",
  "mode": "params",
  "template": {
    "draw": "template.js",
    "params": {
      "title": {
        "type": "string",
        "required": true,
        "maxChars": 12
      },
      "subtitle": {
        "type": "string",
        "maxChars": 24,
        "default": ""
      },
      "plaques": {
        "type": "array",
        "maxItems": 2,
        "maxChars": 12,
        "default": []
      },
      "characters": {
        "type": "objects",
        "maxItems": 4,
        "fields": {
          "kind": {
            "enum": [
              "adult",
              "child",
              "animal",
              "object"
            ],
            "default": "adult"
          },
          "pose": {
            "enum": [
              "stand",
              "walk",
              "wave",
              "raise",
              "sit"
            ],
            "default": "stand"
          },
          "x": {
            "type": "number",
            "default": 0.78
          },
          "scale": {
            "type": "number",
            "default": 1
          },
          "color": {
            "type": "string",
            "default": "#a8432e"
          },
          "prop": {
            "enum": [
              "none",
              "staff",
              "fan",
              "lantern",
              "blade"
            ],
            "default": "none"
          }
        },
        "default": [
          {
            "kind": "adult",
            "pose": "stand",
            "x": 0.78,
            "scale": 1,
            "color": "#a8432e",
            "prop": "none"
          }
        ]
      }
    },
    "needs": {
      "font": [
        "display",
        "body"
      ],
      "image": false,
      "video": false,
      "three": false
    },
    "defaultSfx": "impact-soft",
    "motion": {
      "enter": 0.58,
      "exitRatio": 0.5
    },
    "inkless": true
  },
  "fonts": {
    "display": "sans-900",
    "body": "sans-400",
    "num": "latin-700"
  },
  "rules": {
    "safeMargin": 0.06,
    "forbid": [
      "把故事或人物身份写进 params；title / subtitle / plaques 只写文本，characters[] 只写骨架与姿态",
      "在 characters[] 之外再画一个人物，或让同一场出现两种幕布底色",
      "给模板加卡片参数；戏台必须铺满整帧",
      "在皮影上再叠一层字幕；画面文字即 title，字幕必须为 none",
      "用具体故事名做 kind / pose / prop 的枚举值",
      "在同一场景写 scene.code；本 recipe 只收 scene.params"
    ]
  },
  "captions": {
    "style": "none"
  },
  "audio": {
    "mood": "tense",
    "volume": 0.11,
    "fadeIn": 1.4,
    "fadeOut": 2.2,
    "duck": {
      "level": 0.045,
      "edge": 0.18
    }
  }
}
