{
  "id": "shadow-play",
  "abi": "8",
  "name": "皮影戏",
  "keywords": [
    "皮影",
    "灯影",
    "剪影",
    "戏台",
    "幕布",
    "透光"
  ],
  "when": "需要用透光幕布上的关节剪影演一段动作、靠姿态与操纵杆讲戏时",
  "blocks": [
    "scene.shadow"
  ],
  "style": {
    "fonts": {
      "display": "sans-900",
      "body": "sans-400",
      "num": "latin-700"
    },
    "colors": {
      "bg": "#191008",
      "ink": "#F2DCA8",
      "muted": "#A08663",
      "accent": "#E8A33D",
      "line": "#3A2412"
    },
    "backgrounds": {
      "night": "#191008"
    }
  },
  "rules": {
    "safeMargin": 0.06,
    "scale": {
      "title": 1,
      "label": 0.8,
      "note": 0.6
    },
    "stroke": [
      3,
      6
    ],
    "forbid": [
      "把故事或人物身份写进 block 参数；title / subtitle / plaques 只写文本，characters[] 只写骨架与姿态",
      "在 characters[] 之外再画一个人物，或让同一场出现两种幕布底色",
      "给 scene.shadow 加卡片 rect；戏台必须满幅 rect=[0,0,1,1]",
      "在皮影上再叠一层字幕；画面文字即 title，字幕必须为 none",
      "用具体故事名做 kind / pose / prop 的枚举值"
    ]
  },
  "captions": {
    "style": "none"
  },
  "audio": {
    "mood": "tense",
    "volume": 0.11,
    "fadeIn": 1.4,
    "fadeOut": 2.2,
    "duck": {
      "level": 0.045,
      "edge": 0.18
    }
  },
  "signature": {
    "name": "透光关节剪影",
    "how": [
      "scene.shadow: characters[] 给骨架与姿态，幕布只由 TT.board.stage 画",
      "scene.shadow: 关节铆钉与垂向操纵杆说明它是可活动的纸片"
    ],
    "verify": {
      "t": 1.2,
      "expect": "首帧已有剪影与名牌凭据"
    }
  },
  "verify": [
    {
      "at": 0.15,
      "assert": "ink.insideSafe",
      "args": {
        "margin": 0.06
      }
    },
    {
      "at": 0.9,
      "assert": "element.count.gte",
      "args": {
        "n": 1
      }
    },
    {
      "at": 0.9,
      "assert": "caption.noOverlapSubject",
      "args": {}
    }
  ]
}
