{
  "id": "crayon-guide",
  "abi": "9",
  "name": "蜡笔图解",
  "keywords": [
    "蜡笔",
    "手账",
    "图解",
    "步骤",
    "绘本",
    "亲子"
  ],
  "when": "用暖米纸与蜡笔斜纹把步骤、清单或小知识画成手账时",
  "mode": "params",
  "template": {
    "draw": "template.js",
    "params": {
      "title": {
        "type": "string",
        "required": true,
        "maxChars": 10
      },
      "subtitle": {
        "type": "string",
        "maxChars": 14,
        "default": ""
      },
      "bubble": {
        "type": "string",
        "maxChars": 14,
        "default": ""
      },
      "badge": {
        "type": "string",
        "maxChars": 6,
        "default": "3步搞定"
      },
      "ingredients": {
        "type": "array",
        "maxItems": 4,
        "maxChars": 6,
        "default": [],
        "feel": "旧版纯文本清单；新配方优先用 items[] 图标槽"
      },
      "steps": {
        "type": "array",
        "maxItems": 3,
        "maxChars": 10,
        "default": []
      },
      "times": {
        "type": "array",
        "maxItems": 3,
        "maxChars": 8,
        "default": []
      },
      "note": {
        "type": "string",
        "maxChars": 24,
        "default": ""
      },
      "items": {
        "type": "objects",
        "maxItems": 4,
        "fields": {
          "kind": {
            "enum": [
              "bowl",
              "plate",
              "pot",
              "egg",
              "veg",
              "meat",
              "spice",
              "spoon"
            ],
            "default": "bowl"
          },
          "label": {
            "type": "string",
            "default": "",
            "maxChars": 8
          }
        },
        "default": []
      }
    },
    "needs": {
      "font": [
        "display",
        "hand",
        "num"
      ],
      "image": false,
      "video": false,
      "three": false
    },
    "motion": {
      "enter": 0.66,
      "exitRatio": 0.52
    },
    "inkless": true
  },
  "fonts": {
    "display": "ZTZiYouTi",
    "body": "sans-400",
    "hand": "ZTZiYouTi",
    "num": "latin-700",
    "caption": "sans-900"
  },
  "rules": {
    "safeMargin": 0.06,
    "forbid": [
      "把 params 模板缩成卡片；模板必须铺满整帧",
      "steps 与 times 数量不一致",
      "字幕压住步骤卡或右下角手写注",
      "在同一场景写 scene.code；本 recipe 只收 scene.params"
    ]
  },
  "captions": {
    "style": "handnote",
    "font": "hand",
    "baseSize": 42,
    "lineHeight": 1.34,
    "top": 0.8,
    "at": "auto",
    "maxWidth": 0.5
  },
  "audio": {
    "mood": "soft",
    "volume": 0.08,
    "fadeIn": 1.5,
    "fadeOut": 2.2,
    "duck": {
      "level": 0.04,
      "edge": 0.22
    }
  }
}
