{
  "id": "blackboard-lesson",
  "abi": "9",
  "name": "黑板教学",
  "keywords": [
    "黑板",
    "粉笔",
    "教学",
    "推导",
    "板书",
    "公式"
  ],
  "when": "需要把一堂课的推导过程按书写节拍逐笔写在黑板上时",
  "fonts": {
    "display": "sans-400",
    "body": "sans-400",
    "num": "latin-700",
    "caption": "sans-900",
    "hand": "ZTZiYouTi",
    "serif": "WenYuanSerifSC-Bold"
  },
  "rules": {
    "safeMargin": 0.06,
    "scale": {
      "title": 1,
      "label": 0.8,
      "note": 0.6
    },
    "stroke": [
      3,
      6
    ],
    "pen": {
      "mode": "fixed",
      "value": "chalk"
    },
    "board": {
      "mode": "fixed",
      "value": "blackboard"
    },
    "forbid": [
      "把讲课内容写成固定模板参数；讲哪一课由 storyboard 的 code 决定",
      "在 code 里用 Math.random、Date 等墙钟随机，板书必须确定性",
      "黑板与卡片混排，或同一幕出现两种字幕样式",
      "墨迹或文字越出 safeMargin",
      "把整段旁白原样抄进 code 当板书；code 只写推导与标注",
      "在同一场景写 scene.params；本 recipe 只收 scene.code"
    ]
  },
  "captions": {
    "style": "plain",
    "font": "caption",
    "baseSize": 44,
    "lineHeight": 1.34,
    "top": 0.8,
    "at": "top",
    "size": 0.92,
    "maxWidth": 0.62
  },
  "audio": {
    "mood": "soft",
    "volume": 0.1,
    "fadeIn": 1.6,
    "fadeOut": 2.4,
    "duck": {
      "level": 0.04,
      "edge": 0.22
    }
  },
  "mode": "code"
}
