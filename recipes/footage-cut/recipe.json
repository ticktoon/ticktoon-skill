{
  "id": "footage-cut",
  "abi": "1",
  "name": "实拍快切",
  "keywords": ["实拍", "素材", "航拍", "城市", "压屏字", "纪录片"],
  "mode": "params",
  "when": [
    "已经有实拍素材（Pexels 或本地），希望保留画面质感。",
    "文案是短句或两行陈述，不需要字幕逐字跟读。",
    "需要真实场景、人物、街道、自然，而不是插画或图表。"
  ],
  "notWhen": [
    "没有素材、也不准备检索；改用 scene.code 型 recipe。",
    "需要解释机制、步骤或数据；改用 whiteboard-explainer / crayon-guide。",
    "需要逐字字幕；改用 illustrated-story 或白板 recipe。"
  ],
  "template": {
    "draw": "template.js",
    "params": {
      "src": {
        "type": "string",
        "required": true
      },
      "start": {
        "type": "number",
        "feel": "源视频起始秒"
      },
      "title": {
        "type": "string",
        "required": true,
        "maxChars": 28,
        "feel": "1–2 行短句，用 \\n 显式换行"
      },
      "kicker": {
        "type": "string",
        "required": true,
        "maxChars": 24
      },
      "keywords": {
        "type": "array",
        "maxItems": 4,
        "maxChars": 12,
        "default": []
      },
      "credit": {
        "type": "string",
        "default": "Pexels",
        "maxChars": 40,
        "feel": "写 auto 时 assets fetch 回填作者；降级时明确标注内置素材"
      }
    },
    "needs": {
      "image": false,
      "video": true,
      "three": false
    },
    "resources": [
      {
        "type": "font",
        "name": "sans-900"
      },
      {
        "type": "font",
        "name": "sans-400"
      }
    ],
    "motion": {
      "enter": 0.56,
      "exitRatio": 0.55
    },
    "inkless": true
  },
  "rules": {
    "safeMargin": 0.055,
    "forbid": [
      "把实拍素材缩成卡片；模板必须满幅 cover",
      "在实拍上再叠一层字幕；压屏字即正文，字幕必须为 none",
      "自动折行；分行只能由 title 里的 \n 决定",
      "用素材名或 Pexels id 当题材枚举；keywords 只描述检索意图",
      "断网或检索失败时静默留空画面；必须明确降级到内置素材"
    ]
  },
  "captions": {
    "style": "none"
  },
  "audio": {
    "mood": "soft",
    "volume": 0.1,
    "fadeIn": 2,
    "fadeOut": 2.6,
    "duck": {
      "level": 0.04,
      "edge": 0.22
    }
  }
}
