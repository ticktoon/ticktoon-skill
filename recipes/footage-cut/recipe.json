{
  "id": "footage-cut",
  "abi": "9",
  "name": "实拍快切",
  "keywords": [
    "实拍",
    "素材",
    "航拍",
    "城市",
    "压屏字",
    "纪录片"
  ],
  "when": "用真实素材铺满画面、只压一两行硬短句，靠镜头切换而不是手绘讲事实时",
  "mode": "params",
  "template": {
    "draw": "template.js",
    "params": {
      "src": {
        "type": "string",
        "required": true
      },
      "start": {
        "type": "number",
        "feel": "源视频起始秒"
      },
      "title": {
        "type": "string",
        "required": true,
        "maxChars": 28,
        "feel": "1–2 行短句，用 \\n 显式换行"
      },
      "kicker": {
        "type": "string",
        "required": true,
        "maxChars": 24
      },
      "keywords": {
        "type": "array",
        "maxItems": 4,
        "maxChars": 12,
        "default": []
      },
      "credit": {
        "type": "string",
        "default": "Pexels",
        "maxChars": 40,
        "feel": "写 auto 时 assets fetch 回填作者；降级时明确标注内置素材"
      }
    },
    "needs": {
      "font": [
        "display",
        "body"
      ],
      "image": false,
      "video": true,
      "three": false
    },
    "motion": {
      "enter": 0.56,
      "exitRatio": 0.55
    },
    "inkless": true
  },
  "fonts": {
    "display": "sans-900",
    "body": "sans-400",
    "num": "latin-700"
  },
  "rules": {
    "safeMargin": 0.055,
    "forbid": [
      "把实拍素材缩成卡片；模板必须满幅 cover",
      "在实拍上再叠一层字幕；压屏字即正文，字幕必须为 none",
      "自动折行；分行只能由 title 里的 \n 决定",
      "用素材名或 Pexels id 当题材枚举；keywords 只描述检索意图",
      "断网或检索失败时静默留空画面；必须明确降级到内置素材"
    ]
  },
  "captions": {
    "style": "none"
  },
  "audio": {
    "mood": "soft",
    "volume": 0.1,
    "fadeIn": 2,
    "fadeOut": 2.6,
    "duck": {
      "level": 0.04,
      "edge": 0.22
    }
  }
}
